              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group_size\": 4\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/tournaments/invalid-id/brackets/generate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
