      ]
    },
    {
      "name": "4) Generate Brackets - Status Not close_registration",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group_size\": 4\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/tournaments/{{tournament_id_not_close}}/brackets/generate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "tournaments",
            "{{tournament_id_not_close}}",
            "brackets",
            "generate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Wrong status returns 400\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test(\"Message explains close_registration rule\", function () {",
              "  pm.expect(jsonData.message || \"\").to.include(\"close_registration\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5) Generate Brackets - Success",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"group_size\": {{group_size}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/v1/tournaments/{{tournament_id_close_registration}}/brackets/generate",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "tournaments",
            "{{tournament_id_close_registration}}",
            "brackets",
            "generate"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Success returns 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test(\"Response has brackets array\", function () {",
              "  pm.expect(jsonData.success).to.eql(true);",
              "  pm.expect(jsonData.data).to.be.an(\"array\");",
              "  pm.expect(jsonData.data.length).to.be.greaterThan(0);",
              "});",
              "",
              "pm.test(\"Each bracket has expected fields\", function () {",
              "  (jsonData.data || []).forEach((bracket) => {",
              "    pm.expect(bracket).to.have.property(\"name\");",
              "    pm.expect(bracket).to.have.property(\"participants\");",
              "  });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6) Get Brackets - Success",
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{admin_access_token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/tournaments/{{tournament_id_close_registration}}/brackets",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "tournaments",
            "{{tournament_id_close_registration}}",
            "brackets"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Get brackets returns 200\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const jsonData = pm.response.json();",
              "pm.test(\"Get brackets has populated participants\", function () {",
              "  pm.expect(jsonData.success).to.eql(true);",
              "  pm.expect(jsonData.data).to.be.an(\"array\");",
              "  pm.expect(jsonData.data.length).to.be.greaterThan(0);",
              "  (jsonData.data || []).forEach((bracket) => {",
              "    pm.expect(bracket).to.have.property(\"participants\");",
              "    (bracket.participants || []).forEach((player) => {",
              "      pm.expect(player).to.have.property(\"full_name\");",
              "      pm.expect(player).to.have.property(\"elo_score\");",
              "      pm.expect(player).to.have.property(\"skill_rank\");",
              "    });",
              "  });",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
